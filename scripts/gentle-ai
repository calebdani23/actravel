#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
REPO="$(cd -- "$SCRIPT_DIR/.." && pwd)"
GENTLE_HOME="$REPO/.gentle-home"
GENTLE_AI_REAL_HOME="${GENTLE_AI_REAL_HOME:-$HOME}"
GENTLE_AI_BIN="$GENTLE_AI_REAL_HOME/.local/bin/gentle-ai"

if [ ! -d "$REPO" ]; then
  echo "ERROR: Repo not found at $REPO"
  exit 1
fi

if [ ! -x "$GENTLE_AI_BIN" ]; then
  echo "ERROR: Gentle-AI binary not found at $GENTLE_AI_BIN"
  exit 1
fi

mkdir -p "$GENTLE_HOME/.cache/opencode"
mkdir -p "$GENTLE_HOME/.config/opencode"
mkdir -p "$REPO/.opencode-runtime/data"
mkdir -p "$REPO/.opencode-runtime/state"
mkdir -p "$GENTLE_HOME/.gentle-ai/cache"

# Reuse the repo's working OpenCode cache when available.
if [ -d "$REPO/.opencode-runtime/cache/opencode" ]; then
  cp -a "$REPO/.opencode-runtime/cache/opencode/." "$GENTLE_HOME/.cache/opencode/"
fi

# Gentle-AI rejects a symlinked opencode.json, so copy it into HOME.
if [ -f "$REPO/opencode.json" ]; then
  rm -f "$GENTLE_HOME/.config/opencode/opencode.json"
  cp -f "$REPO/opencode.json" "$GENTLE_HOME/.config/opencode/opencode.json"
  chmod 600 "$GENTLE_HOME/.config/opencode/opencode.json"
fi

export HOME="$GENTLE_HOME"
export XDG_CACHE_HOME="$GENTLE_HOME/.cache"
export XDG_CONFIG_HOME="$GENTLE_HOME/.config"
export XDG_DATA_HOME="$REPO/.opencode-runtime/data"
export XDG_STATE_HOME="$REPO/.opencode-runtime/state"
export OPENCODE_CONFIG="$GENTLE_HOME/.config/opencode/opencode.json"
export OPENCODE_CONFIG_DIR="$REPO/.opencode"

set +e
"$GENTLE_AI_BIN" "$@"
status=$?
set -e

if [ -f "$GENTLE_HOME/.config/opencode/opencode.json" ]; then
  cp -f "$GENTLE_HOME/.config/opencode/opencode.json" "$REPO/opencode.json"
fi

exit "$status"
