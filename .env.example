# Public site origin used for canonical URLs and absolute email-safe CTA links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public browser credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable...

# Server-only Supabase key/connection. Never expose these in the browser.
SUPABASE_SECRET_KEY=sb_secret...
SUPABASE_DB_URL=

# Optional first-user bootstrap. Use real values only in local/hosting env, not git.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=AC Travel Admin
BOOTSTRAP_ASESOR_EMAIL=
BOOTSTRAP_ASESOR_PASSWORD=
BOOTSTRAP_ASESOR_NAME=AC Travel Asesor

# WhatsApp Business public contact number for wa.me links.
NEXT_PUBLIC_WHATSAPP_PHONE=529988453455
# Optional server-only salt for hashing IPs in WhatsApp click logs. If empty, no IP hash is stored.
WHATSAPP_CLICK_HASH_SALT=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_WHATSAPP_PHONE_NUMBER_ID=
# Optional trigger allowlist for inbound Meta webhook auto-capture. Supports comma, pipe, or newline separators.
WHATSAPP_INBOUND_TRIGGER_TEXTS=!Hola! Quiero mas informacion.
# Optional max serialized bytes retained in whatsapp_inbound_messages.raw_payload.
WHATSAPP_INBOUND_RAW_PAYLOAD_LIMIT_BYTES=12000

# Resend email notifications for quote requests. Server-only; never expose in the browser.
RESEND_API_KEY=
EMAIL_FROM=AC Travel <quotes@your-verified-resend-domain.com>
# Internal inbox for admin quote notifications. Keep this env-driven; do not hardcode recipients in app code.
EMAIL_ADMIN=ventas@your-business-domain.com

# Google Sheets service account and target sheet for future lead copy sync.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_LEADS_TAB=

# Product defaults
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_DEFAULT_CURRENCY=MXN
